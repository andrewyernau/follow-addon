{
  "schemaVersion": 1,
  "id": "follow-addon",
  "version": "${version}",
  "name": "Follow Addon for Flashback",
  "description": "Adds a two-point camera follow workflow to Flashback's timeline.",
  "authors": [
    "Yernau"
  ],
  "contact": {
    "sources": "https://github.com/andrewyernau/Follow-AddOn"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.yernau.followAddon.client.FollowAddonClient"
    ],
    "main": [
      "com.yernau.followAddon.FollowAddon"
    ]
  },
  "mixins": [
    {
      "config": "follow-addon.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.2 <26.4",
    "flashback": ">=${flashback_version}"
  }
}
